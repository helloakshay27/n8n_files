      {
        "parameters": {
          "jsCode": "const records = $input.all();\n\nconst attendances = [];\n\nfor (const item of records) {\n  const data = item.json;\n\n  attendances.push({\n    org_user_id: data.employeeId,\n    punched_in_at:\n      data.eventType?.toLowerCase() === 'login'\n        ? data.eventTime\n        : null,\n    punched_out_at:\n      data.eventType?.toLowerCase() === 'logout'\n        ? data.eventTime\n        : null\n  });\n}\n\nreturn [\n  {\n    json: {\n      attendances\n    }\n  }\n];"
