        "parameters": {
          "jsCode": "const records = $input.all();\n\nconst testEmployeeIds = [\n  '0718104UAE',\n  '01059678'\n];\n\nreturn records.filter(item => {\n  const employeeId = String(item.json.employeeId || '').trim();\n\n  return testEmployeeIds.includes(employeeId);\n});"
