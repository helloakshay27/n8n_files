      {
        "parameters": {
          "jsCode": "const records = $input.first().json.response || [];\n\nconst today = new Date().toLocaleDateString('en-CA', {\n  timeZone: 'Asia/Kolkata'\n});\n\nconst todayRecords = records.filter(record => {\n  if (!record.eventTime) return false;\n\n  const recordDate = new Date(record.eventTime).toLocaleDateString('en-CA', {\n    timeZone: 'Asia/Kolkata'\n  });\n\n  return recordDate === today;\n});\n\nreturn todayRecords.map(record => ({\n  json: record\n}));"
        },
