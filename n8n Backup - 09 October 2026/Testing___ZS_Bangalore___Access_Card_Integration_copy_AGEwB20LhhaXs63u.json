        "executeOnce": false,
        "alwaysOutputData": true
      },
      {
        "parameters": {
          "jsCode": "const records = $input.all();\n\nfunction formatIST(timestamp) {\n  if (!timestamp) return null;\n\n  // Keep the date/time exactly as received.\n  // Only change the timezone suffix.\n  return timestamp\n    .replace(/\\+00:00$/, '+05:30')\n    .replace(/Z$/, '+05:30');\n}\n\nconst attendances = [];\nconst sourceRecords = [];\n\nfor (const item of records) {\n  const data = item.json;\n\n  const eventTime = formatIST(data.event_time);\n\n  // This is what will be sent to the destination API\n  attendances.push({\n    org_user_id: String(data.employee_id || '').trim(),\n\n    punched_in_at:\n      data.event_type?.toLowerCase() === 'login'\n        ? eventTime\n        : null,\n\n    punched_out_at:\n      data.event_type?.toLowerCase() === 'logout'\n        ? eventTime\n        : null\n  });\n\n  // Keep the original Access360 information inside n8n\n  // so we can use it later for PostgreSQL logging.\n  sourceRecords.push({\n    access360_id: data.access360_id,\n    employee_id: data.employee_id,\n    event_type: data.event_type,\n    event_time: eventTime\n  });\n}\n\n// Return ONE n8n item\nreturn [\n  {\n    json: {\n      attendances: attendances,\n      source_records: sourceRecords\n    }\n  }\n];"
        },
