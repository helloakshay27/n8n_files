      {
        "parameters": {
          "jsCode": "// Get employee API response\nconst employeeResponse = $('Access360 - Get Employees').first().json.response;\n\n// Get attendance API response\nconst attendanceResponse = $('Access360 - Get Attendance Data').first().json.response;\n\n\n// --------------------------------------------------\n// 1. Build Employee ID → Employee Name mapping\n// --------------------------------------------------\n\nconst employeeMap = {};\n\nfor (const emp of employeeResponse) {\n\n  if (emp.empID) {\n    employeeMap[String(emp.empID).trim()] = emp.empName || null;\n  }\n\n}\n\n\n// --------------------------------------------------\n// 2. Process attendance records\n// --------------------------------------------------\n\nconst result = [];\n\nfor (const attendance of attendanceResponse) {\n\n  const employeeId = String(\n    attendance.employeeId || ''\n  ).trim();\n\n  result.push({\n    json: {\n      employeeId: employeeId,\n\n      employeeName: employeeMap[employeeId] || null,\n\n      eventType: attendance.eventType || null,\n\n      eventTime: attendance.eventTime || null,\n\n      branchName: attendance.branchName || null,\n\n      sourceId: attendance.id || null\n    }\n  });\n\n}\n\n\nreturn result;"
        },
