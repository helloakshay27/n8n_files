      {
        "parameters": {
          "jsCode": "const inputItems = $input.all();\n\nconst records = inputItems.flatMap(item => {\n  const response = item.json.response;\n\n  if (Array.isArray(response)) {\n    return response;\n  }\n\n  if (item.json.id !== undefined) {\n    return [item.json];\n  }\n\n  return [];\n});\n\nreturn records.map(record => ({\n  json: {\n    access360_id: record.id,\n    employee_id: String(record.employeeId),\n    event_type: String(record.eventType).toLowerCase(),\n    event_time: record.eventTime\n  }\n}));\n\n\n\n// const inputItems = $input.all();\n\n// // Get the attendance records from the API response\n// const records = inputItems.flatMap(item => {\n//   const response = item.json.response;\n\n//   // Handle the API's response array\n//   if (Array.isArray(response)) {\n//     return response;\n//   }\n\n//   // Also handle individual attendance items\n//   if (item.json.id !== undefined) {\n//     return [item.json];\n//   }\n\n//   return [];\n// });\n\n// // Prepare records for duplicate checking\n// return records.map(record => ({\n//   json: {\n//     access360_id: record.id,\n//     employee_id: record.employeeId,\n//     event_type: record.eventType,\n//     event_time: record.eventTime\n//   }\n// }));\n\n\n\n\n\n\n\n\n\n\n\n\n\n// const records = $input.all();\n\n// return records.map(item => ({\n//   json: {\n//     access360_id: item.json.id,\n//     employee_id: item.json.employeeId,\n//     event_type: item.json.eventType,\n//     event_time: item.json.eventTime\n//   }\n// }));"
