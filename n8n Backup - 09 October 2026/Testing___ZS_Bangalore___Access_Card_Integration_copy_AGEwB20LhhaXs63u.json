          "query": "SELECT\n    {{ $json.access360_id }} AS access360_id,\n    '{{ $json.employee_id }}' AS employee_id,\n    '{{ $json.event_type }}' AS event_type,\n    '{{ $json.event_time }}' AS event_time,\n    EXISTS (\n        SELECT 1\n        FROM access360_processed_attendance\n        WHERE access360_id = {{ $json.access360_id }}\n    ) AS already_processed;",
