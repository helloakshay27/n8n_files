      {
        "parameters": {
          "jsCode": "// Get the batch API response\nconst responseItems = $input.all();\n\nif (responseItems.length === 0) {\n  return [];\n}\n\n// Get the original batch data from Prepare Attendance Payload\nconst payloadItems = $('Prepare Attendance Payload').all();\n\nif (payloadItems.length === 0) {\n  throw new Error('No data found from Prepare Attendance Payload');\n}\n\nconst payload = payloadItems[0].json;\n\nconst sourceRecords = payload.source_records || [];\nconst attendances = payload.attendances || [];\n\n// Get all results returned by the destination API\nconst results = responseItems.flatMap(item => {\n  return Array.isArray(item.json.results)\n    ? item.json.results\n    : [];\n});\n\nconst output = [];\n\n// Match API results back to the original records\nfor (const result of results) {\n\n  // Only process successful records\n  if (String(result.status || '').toLowerCase() !== 'success') {\n    continue;\n  }\n\n  const orgUserId = String(result.org_user_id || '').trim();\n\n  // Find the original record using employee/org_user_id\n  const matchingIndexes = [];\n\n  for (let i = 0; i < attendances.length; i++) {\n    if (\n      String(attendances[i].org_user_id || '').trim() === orgUserId\n    ) {\n      matchingIndexes.push(i);\n    }\n  }\n\n  if (matchingIndexes.length === 0) {\n    continue;\n  }\n\n  // Find an original record that has not already been mapped\n  let matchedIndex = null;\n\n  for (const index of matchingIndexes) {\n    const alreadyUsed = output.some(\n      item =>\n        item.json.access360_id === sourceRecords[index]?.access360_id\n    );\n\n    if (!alreadyUsed) {\n      matchedIndex = index;\n      break;\n    }\n  }\n\n  if (matchedIndex === null) {\n    continue;\n  }\n\n  const original = sourceRecords[matchedIndex];\n\n  output.push({\n    json: {\n      access360_id: original.access360_id,\n      employee_id: original.employee_id,\n      event_type: original.event_type,\n      event_time: original.event_time,\n      destination_attendance_id: result.attendance_id\n    }\n  });\n}\n\nreturn output;"
        },
