      {
        "parameters": {
          "jsCode": "\nreturn items.map(item => {\n\n  // Today's date in YYYYMMDD format (IST)\n  const today = new Intl.DateTimeFormat('en-CA', {\n    timeZone: 'Asia/Kolkata',\n    year: 'numeric',\n    month: '2-digit',\n    day: '2-digit'\n  }).format(new Date()).replace(/-/g, '');\n\n  // External transaction ID\n  const externalTransactionId = `RULE_13_${item.json.ID}_${today}`;\n\n  return {\n    json: {\n      customer_code: item.json.Customer_No__c,\n      id: item.json.ID,\n      customer_mobile: item.json.customer_mobile,\n      customer_name: item.json.Name,\n      email: item.json.Account_Email__c,\n      amount: 100 * 0.001, // 0.1% of 100 = 0.1\n      remarks: \"EOI Booking Reward\",\n      transaction_note: \"EOI Booking\",\n      payment_mode: \"cash\",\n      topup_by: \"automation\",\n      today_delta_additions: item.json.today_delta_additions,\n\n      // Existing fields\n      rule_name: \"EOI Booking Reward Incentive\",\n      n8n_rule_id: \"13\",\n      category: \"Booking\",\n\n      // New fields\n      external_transaction_id: externalTransactionId,\n      organization_id: 71,\n      organization_name: \"Rustomjee\"\n    }\n  };\n\n});"
        },
