        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT\n    (\n        EXISTS (\n            SELECT 1\n            FROM wallet_transaction_logs\n            WHERE external_transaction_id = '{{$json.external_transaction_id}}'\n              AND status IN ('SUCCESS', 'DUPLICATE')\n        )\n        OR\n        EXISTS (\n            SELECT 1\n            FROM wallet_transaction_logs\n            WHERE customer_code = '{{$json.customer_code}}'\n              AND remarks = '{{($json.remarks || \"\").replace(/'/g, \"''\")}}'\n              AND status IN ('SUCCESS', 'DUPLICATE')\n        )\n    ) AS exists;\n\n/* SELECT status\nFROM wallet_transaction_logs\nWHERE customer_code = '{{$json.customer_code}}'\nAND remarks = '{{$json.remarks}}'\nAND status = 'SUCCESS'\nLIMIT 1; */",
