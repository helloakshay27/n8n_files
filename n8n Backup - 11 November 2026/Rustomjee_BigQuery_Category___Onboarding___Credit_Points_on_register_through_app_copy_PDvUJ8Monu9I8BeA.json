      {
        "parameters": {
          "operation": "executeQuery",
          "query": "\nINSERT INTO wallet_transaction_logs (\n    customer_code,\n    amount,\n    remarks,\n    reference_id,\n    transaction_note,\n    status,\n    status_code,\n    message,\n    request_payload,\n    response_payload,\n    execution_id,\n    rule_name,\n    n8n_rule_id,\n    category,\n    external_transaction_id,\n    organization_id,\n    organization_name,\n    created_at,\n    updated_at\n)\nVALUES (\n    '{{$json.customer_code}}',\n    {{$json.amount || 0}},\n    '{{($json.remarks || \"\").replace(/'/g, \"''\")}}',\n    {{$json.reference_id ? `'${$json.reference_id}'` : 'NULL'}},\n    '{{($json.transaction_note || \"\").replace(/'/g, \"''\")}}',\n    '{{($json.status || \"\").replace(/'/g, \"''\")}}',\n    {{$json.status_code || 500}},\n    '{{($json.message || \"\").replace(/'/g, \"''\")}}',\n    '{{JSON.stringify($json.request_payload || {}).replace(/'/g, \"''\")}}'::jsonb,\n    '{{JSON.stringify($json.response_payload || {}).replace(/'/g, \"''\")}}'::jsonb,\n    {{$json.execution_id ? `'${$json.execution_id}'` : 'NULL'}},\n    '{{($json.rule_name || \"\").replace(/'/g, \"''\")}}',\n    {{$json.n8n_rule_id ? `'${$json.n8n_rule_id}'` : 'NULL'}},\n    '{{($json.category || \"\").replace(/'/g, \"''\")}}',\n    '{{($json.external_transaction_id || \"\").replace(/'/g, \"''\")}}',\n    {{$json.organization_id || 'NULL'}},\n    '{{($json.organization_name || \"\").replace(/'/g, \"''\")}}',\n    NOW(),\n    NOW()\n);",
          "options": {}
