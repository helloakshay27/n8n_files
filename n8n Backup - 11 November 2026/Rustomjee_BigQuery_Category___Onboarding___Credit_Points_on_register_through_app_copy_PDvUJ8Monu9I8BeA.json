      {
        "parameters": {
          "jsCode": "\nconst today = new Date().toISOString().split('T')[0];\n\nreturn items.map(item => {\n\n  const customerCode = item.json.customer_code;\n  const mobile = item.json.mobile || '';\n  const email = item.json.email || '';\n\n  // Today's date in YYYYMMDD format (IST)\n  const todayFormatted = new Intl.DateTimeFormat('en-CA', {\n    timeZone: 'Asia/Kolkata',\n    year: 'numeric',\n    month: '2-digit',\n    day: '2-digit'\n  }).format(new Date()).replace(/-/g, '');\n\n  // External transaction ID\n  const externalTransactionId = `RULE_6_${customerCode}_${todayFormatted}`;\n\n  return {\n    json: {\n      customer_code: customerCode,\n      customer_mobile: mobile,\n      email: email,\n      customer_unique_key: `${mobile}_${email}`,\n      opportunity_id: customerCode,\n      today_date: today,\n      amount: 5,\n      remarks: \"App Download Reward\",\n      transaction_note: \"Credit point for taking survey\",\n      payment_mode: \"cash\",\n      topup_by: \"automation\",\n      today_delta_additions: today,\n\n      // Existing fields\n      rule_name: \"App Download Reward\",\n      n8n_rule_id: \"6\",\n      category: \"Engagement\",\n\n      // New fields\n      external_transaction_id: externalTransactionId,\n      organization_id: 71,\n      organization_name: \"Rustomjee\"\n    }\n  };\n});"
        },
