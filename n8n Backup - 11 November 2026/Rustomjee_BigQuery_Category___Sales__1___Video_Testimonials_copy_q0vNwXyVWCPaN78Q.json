      {
        "parameters": {
          "jsCode": "const today = new Intl.DateTimeFormat('en-CA', {\n  timeZone: 'Asia/Kolkata',\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit'\n}).format(new Date()).replace(/-/g, '');\n\nconst output = [];\n\nfor (const item of items) {\n\n  // Only process testimonials with a video URL\n  if (\n    !item.json.video_url ||\n    item.json.video_url.trim() === ''\n  ) {\n    continue;\n  }\n\n  const externalTransactionId = `RULE_17_${item.json.id}_${today}`;\n\n  output.push({\n    json: {\n      id: item.json.id,\n      customer_code: item.json.customer_code,\n      customer_name: item.json.user_name,\n      booking_number: item.json.booking_number,\n      video_url: item.json.video_url,\n      video_preview_image_url: item.json.video_preview_image_url,\n      testimonial_content: item.json.content,\n\n      amount: 0, // Update once reward points are finalized\n      remarks: \"Testimonials reward\",\n      transaction_note: \"Reward points for submitting a video testimonial\",\n      payment_mode: \"cash\",\n      topup_by: \"automation\",\n\n      rule_name: \"Testimonials Reward\",\n      n8n_rule_id: \"17\",\n      category: \"Engagement\",\n\n      external_transaction_id: externalTransactionId,\n      organization_id: 71,\n      organization_name: \"Rustomjee\"\n    }\n  });\n}\n\nreturn output;"
        },
